{
  "version": 1,
  "dashboard": {
    "clockFormat": "12h",
    "showSeconds": true,
    "showDate": true,
    "dateFormat": "long",
    "weatherLocation": "Chandigarh",
    "weatherUnit": "metric",
    "showWeather": true,
    "weatherRefreshMinutes": 30,
    "defaultDashboardTab": 0
  },
  "bar": {
    "marginTop": 5,
    "exclusiveZone": 26,
    "backgroundOpacity": 0.7,
    "statusDuration": 500,
    "workspaceCount": 10
  },
  "launcher": {
    "columns": 2,
    "maxResults": 70,
    "iconSize": 28
  },
  "wallpaper": {
    "directory": "~/Pictures/wallpapers",
    "transitionDuration": 1.5,
    "transitionType": "random",
    "resizeMode": "crop"
  },
  "notifications": {
    "toastTimeout": 3000,
    "keepExpired": true,
    "doNotDisturb": false,
    "historyLimit": 50
  },
  "lock": {
    "monitor": "eDP-1",
    "useScreenshot": true,
    "blur": 32,
    "dim": 0.45
  }
}
